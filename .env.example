# Local dev (cargo run). On Lambda these come from template.yaml parameters.
PORT=3000
SITE_URL=http://localhost:3000
# Leave CONTACT_FROM empty to log contact messages instead of sending via SES.
CONTACT_FROM=
CONTACT_TO=info@digitus.do
ASSET_VERSION=dev
ORIGIN_VERIFY_SECRET=
RUST_LOG=info,digitus=debug
